{
  "name": "Belege – Steuerbelege",
  "short_name": "Belege",
  "description": "Kassenzettel, Rechnungen und Tankbelege scannen, sortieren und als Excel für den Steuerberater exportieren.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f6f6",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png"] }]
    }
  }
}
